# OpenRouter API 설정
# https://openrouter.ai 에서 API 키를 발급받아 아래에 입력하세요.
# 이 파일을 .env로 복사한 후 사용하세요.
# .env 파일은 절대 git에 커밋하지 마세요!

OPENROUTER_API_KEY=your_api_key_here

# 사용할 LLM 모델 (기본값: 무료 모델)
# 예: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 모델 단가 (1M 토큰당 USD) - OpenRouter 가격표 참조
# 무료 모델은 0으로 설정
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
